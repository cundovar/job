[Unit]
Description=Private CV agent bridge for Codex and Claude subscription CLIs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/job-search-cli-bridge/workspace
Environment=PYTHONUNBUFFERED=1
Environment=CV_CLI_BRIDGE_WORKSPACE=%h/.local/share/job-search-cli-bridge/workspace
Environment=CV_CLI_BRIDGE_PROVIDER_ORDER=codex,claude
Environment=CV_CLI_BRIDGE_TIMEOUT_SECONDS=300
Environment=CV_CLI_BRIDGE_REQUEST_TIMEOUT_SECONDS=10
Environment=CV_CLI_BRIDGE_MAX_CONNECTIONS=8
# Seul chemin à adapter à l'installation : le socket et le jeton sont déduits de
# celui-ci par tools/cv_cli_bridge.py (ROOT = parent de tools/). Le chemin précédent,
# %h/apps/job-search-automation-package, ne correspondait à aucun clone existant.
ExecStart=/usr/bin/python3 %h/Bureau/perso/code_perso/job-search-automation-package/tools/cv_cli_bridge.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
