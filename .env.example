# Configuration Environment Variables
# Copier ce fichier vers .env et remplir avec vos vraies valeurs

# ============================================
# DeepSeek API Configuration
# ============================================
# Obtenez votre clé sur : https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Fallback facultatif si DeepSeek échoue
ANTHROPIC_API_KEY=

# Agents IA dédiés à la construction du CV
CV_DEEPSEEK_MODEL=deepseek-v4-flash
CV_CLAUDE_MODEL=claude-sonnet-4-6
CV_AI_TIMEOUT_SECONDS=60
CV_AI_TEMPERATURE=0.2
CV_AI_MAX_TOKENS=5000

# ============================================
# Google Sheets API Configuration
# ============================================
# 1. Créer un projet sur Google Cloud Console
# 2. Activer Google Sheets API
# 3. Créer un Service Account
# 4. Télécharger le JSON credentials
# 5. Copier TOUT le contenu JSON ici (sur une seule ligne)
GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ID du Google Sheet (trouvé dans l'URL du sheet)
# Exemple URL : https://docs.google.com/spreadsheets/d/1ABC123DEF456/edit
# ID = 1ABC123DEF456
GOOGLE_SHEET_ID=your-google-sheet-id-here

# ============================================
# Email Configuration (Gmail SMTP)
# ============================================
# Email expéditeur (votre Gmail)
EMAIL_SENDER=your-email@gmail.com

# Password d'application Gmail (PAS votre mot de passe principal)
# Comment obtenir : 
# 1. Aller sur myaccount.google.com
# 2. Sécurité > Validation en deux étapes (activer si pas déjà fait)
# 3. Mots de passe des applications > Générer
EMAIL_PASSWORD=your-16-char-app-password

# Email destinataire (où recevoir les notifications)
EMAIL_RECIPIENT=varas.cundo@gmail.com

# Configuration SMTP (laisser par défaut pour Gmail)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ============================================
# Scraping Configuration (Optionnel)
# ============================================
# Délai entre chaque requête (secondes)
SCRAPING_DELAY_SECONDS=2

# Nombre max d'offres par site
MAX_JOBS_PER_SITE=50

# Nombre de mots-clés explorés par source (quota réparti équitablement)
MAX_KEYWORDS_PER_SOURCE=10

# Identifiants géographiques APEC, 711 = Île-de-France
APEC_LOCATION_IDS=711

# Timeout pour les requêtes (secondes)
REQUEST_TIMEOUT_SECONDS=30

# ============================================
# AI Analysis Configuration (Optionnel)
# ============================================
# Score minimum pour déclencher l'analyse IA
SCORE_THRESHOLD_AI_ANALYSIS=50

# Température DeepSeek (0.0 = déterministe, 1.0 = créatif)
DEEPSEEK_TEMPERATURE=0.3

# Max tokens par analyse
DEEPSEEK_MAX_TOKENS=1000

# ============================================
# Cache Configuration (Optionnel)
# ============================================
# Durée de cache pour éviter les doublons (jours)
CACHE_DURATION_DAYS=30

# ============================================
# Logging Configuration (Optionnel)
# ============================================
# Niveau de log : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Chemin du dossier logs
LOG_PATH=data/logs/

# ============================================
# Development / Debug (Optionnel)
# ============================================
# Mode debug (true/false)
DEBUG_MODE=false

# Lancer sans envoyer d'email (true/false)
DRY_RUN=false

# ============================================
# GitHub Actions (Ne pas remplir, utiliser Secrets)
# ============================================
# Ces variables seront configurées dans GitHub Secrets
# Ne JAMAIS commit ce fichier .env dans Git !
